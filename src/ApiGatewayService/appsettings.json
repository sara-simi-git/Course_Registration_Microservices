{
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/course/{**catch-all}"
        }
      },
      "registration-route": {
        "ClusterId": "registration-cluster",
        "Match": {
          "Path": "/api/registration/{**catch-all}"
        }
      },
      "registration-health-route": {
        "ClusterId": "registration-cluster",
        "Match": {
          "Path": "/api/registration/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/registration"
          }
        ]
      },
      "registration-health-catchall-route": {
        "ClusterId": "registration-cluster",
        "Match": {
          "Path": "/api/registration/health/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/registration"
          }
        ]
      },
      "bff-health-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "/api/bff/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/bff"
          }
        ]
      },
      "inventory-health-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/inventory"
          }
        ]
      },
      "inventory-health-catchall-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/health/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/inventory"
          }
        ]
      },
      "auth-health-route": {
        "ClusterId": "usermanagement-cluster",
        "Match": {
          "Path": "/api/auth/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/auth"
          }
        ]
      },
      "course-health-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/course/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/course"
          }
        ]
      },
      "notification-health-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/health"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/notification"
          }
        ]
      },
      "bff-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "/api/bff/{**catch-all}"
        }
      },
      "bff-swagger-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "/bff/swagger"
        }
      },
      "bff-swagger-catchall-route": {
        "ClusterId": "bff-cluster",
        "Match": {
          "Path": "/bff/swagger/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "usermanagement-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "usermanagement-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      },
      "employee-route": {
        "ClusterId": "usermanagement-cluster",
        "Match": {
          "Path": "/api/employee/{**catch-all}"
        }
      }
      ,"lecturer-route": {
          "ClusterId": "catalog-cluster",
          "Match": {
            "Path": "/api/lecturer/{**catch-all}"
  }
}
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog/dest1": {
            "Address": "http://catalog.lb:80"
          }
        }
      },
      "registration-cluster": {
        "Destinations": {
          "registration/dest1": {
            "Address": "http://registration.api:8080"
          }
        }
      },
      "bff-cluster": {
        "Destinations": {
          "bff/dest1": {
            "Address": "http://bff.api:80"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification/dest1": {
            "Address": "http://notificationservice:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory/dest1": {
            "Address": "http://inventory.api:8080"
          }
        }
      },
      "usermanagement-cluster": {
        "Destinations": {
          "usermanagement/dest1": {
            "Address": "http://usermanagement.api:8080"
          }
        }
      }
      
    }
  }
}
