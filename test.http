@host = http://localhost:8080

####################################################
### 1. Register User + Employee
####################################################
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "id": "333441433",
  "firstName": "Rina",
  "lastName": "Demo",
  "email": "gila.demo@test.com",
  "phone": "0501234567",
  "password": "Password123!"
}

###

GET {{host}}/api/employee/employeesList

###

####################################################
### 2. Create Lecturer
####################################################
POST {{host}}/api/lecturer
Content-Type: application/json

{
  "fullName": "John Smith",
  "email": "john@test.com",
  "phone": "0501111111",
  "companyName": "OpenAI",
  "cost": 1500
}

###

GET {{host}}/api/lecturer/lecturersList

###

####################################################
### 3. Create Course
####################################################
POST {{host}}/api/course
Content-Type: application/json

{
  "name": "Microservices",
  "description": "Full Stack Course",
  "creditCost": 10,
  "registrationDeadline": "2026-12-31T00:00:00",
  "location": "Room 105",
  "meetingLink": "",
  "startDate": "2027-01-05T09:00:00",
  "lecturerId": "a3d7ea39-715f-4fba-a3e6-44c3d67053ff"
}

###

GET {{host}}/api/course/coursesList

###

####################################################
### 4. Create Inventory
####################################################
POST {{host}}/api/inventory
Content-Type: application/json

{
  "courseId": "e89f695d-94c4-4ed7-8d83-6321ccd6d1e3",
  "maxPlaces": 20
}

###

GET {{host}}/api/inventory

###

####################################################
### 5. Register Employee
####################################################
POST {{host}}/api/registration/register
Content-Type: application/json

{
  "employeeId": 2002,
  "courseId": "a1373543-06e4-4721-9aae-93494181b1cf"
}

###

GET {{host}}/api/registration/employee/4

###

####################################################
### Phase 3 - Gateway, BFF & Load Balancing
####################################################

### 1. Gateway health
GET {{host}}/health/ready

###

### 2. Catalog route through the gateway
GET {{host}}/api/course/coursesList

###

### 3. BFF aggregation endpoint through the gateway
GET {{host}}/api/bff/RegistrationDetail/1

###

PUT {{host}}/api/inventory/capacity
Content-Type: application/json

{
  "courseId": "7218756e-8fab-4a0f-b118-1b9bfce9d589",
  "maxPlaces": 3
}

### 1. Course Service
GET {{host}}/api/course/coursesList

###

### 2. Employee Service
GET {{host}}/api/employee/employeesList

###

### 3. User Service
GET {{host}}/api/user/usersList

###

### 4. Inventory Service
GET {{host}}/api/inventory

###

### 5. Registration Service
GET {{host}}/api/registration/employee/1

### Saga
POST {{host}}/api/registration/register
Content-Type: application/json
X-Correlation-ID: my-saga-001

{
  "employeeId": 6,
  "courseId": "84b0841f-69f6-4bf4-b583-e4994f93993c"
}

###
### 6. Health endpoints
### Gateway
GET {{host}}/health

###
GET {{host}}/health/live

###
GET {{host}}/health/ready

###
### BFF
GET {{host}}/api/bff/health

###
### Health endpoints for each microservice
GET {{host}}/api/registration/health

###
GET {{host}}/api/registration/health/live

###
GET {{host}}/api/registration/health/ready

###
### Inventory Service
GET {{host}}/api/inventory/health

###
### Notification Service
GET {{host}}/api/notification/health

###
### User Management Service
GET {{host}}/api/auth/health

###
### Course Catalog Service
GET {{host}}/api/course/health

####################################################
### Correlation ID trace example
####################################################
### Send one registration request with a known correlation ID
POST {{host}}/api/registration/register
Content-Type: application/json
X-Correlation-ID: my-saga-001

{
  "employeeId": 7,
  "courseId": "7218756e-8fab-4a0f-b118-1b9bfce9d589"
}

### Then search Seq for:
### CorrelationId = 'my-saga-001'